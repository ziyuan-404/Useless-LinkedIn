{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Career OS application record for reconciled history",
  "type": "object",
  "required": ["id", "leadId", "status", "createdAt"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "leadId": {"type": "string", "minLength": 1},
    "status": {"enum": ["prepared", "review-required", "approved", "submitting", "submission-unconfirmed", "submitted", "withdrawn", "rejected"]},
    "createdAt": {"type": "string", "format": "date-time"},
    "submittedAt": {"type": "string", "format": "date-time"},
    "submissionEvidence": {"type": "string", "minLength": 1},
    "authorizationGrantIds": {"type": "array", "items": {"type": "string"}},
    "resumePath": {"type": "string"},
    "letterPath": {"type": "string"},
    "dashboardSynced": {"type": "boolean"},
    "historicalSource": {"type": "object", "properties": {"workbook": {"type": "string"}, "sheet": {"type": "string"}, "row": {"type": "integer", "minimum": 1}}}
  },
  "allOf": [{"if": {"properties": {"status": {"const": "submitted"}}}, "then": {"required": ["submittedAt", "submissionEvidence"]}}]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Useless LinkedIn discovered lead",
  "type": "object",
  "required": ["id", "key", "url", "state", "createdAt", "lastSeenAt"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "key": {"type": "string", "minLength": 1},
    "url": {"type": "string", "format": "uri"},
    "title": {"type": "string"},
    "company": {"type": "string"},
    "portal": {"type": "string"},
    "state": {"$ref": "state.schema.json"},
    "createdAt": {"type": "string", "format": "date-time"},
    "lastSeenAt": {"type": "string", "format": "date-time"},
    "possibleDuplicates": {"type": "array", "items": {"type": "string"}},
    "historyMatch": {"type": "boolean"},
    "historyEvidence": {"type": ["object", "null"], "required": ["source", "sheet", "row", "url"], "properties": {"source": {"const": "dashboard"}, "sheet": {"type": "string"}, "row": {"type": "integer", "minimum": 1}, "url": {"type": "string"}}},
    "applicationMode": {"enum": ["precision", "bulk"]},
    "output": {"type": "string"},
    "dashboardSynced": {"type": "boolean"},
    "submitted": {"type": "boolean"},
    "reason": {"type": "string"},
    "reviewEvidence": {"type": "string"},
    "approvalSnapshot": {"type": "object", "required": ["id", "contextHash", "assessmentHash", "materials", "answersHash", "reviewedAt", "reviewEvidence"], "properties": {"id": {"type": "string"}, "contextHash": {"type": "string"}, "assessmentHash": {"type": "string"}, "materials": {"type": "array", "items": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string"}}}}, "answersHash": {"type": "string"}, "reviewedAt": {"type": "string", "format": "date-time"}, "reviewEvidence": {"type": "string"}}},
    "submissionEvidence": {"type": "string"},
    "events": {"type": "array", "items": {"type": "object", "required": ["at", "from", "to"], "properties": {"at": {"type": "string", "format": "date-time"}, "from": {"$ref": "state.schema.json"}, "to": {"$ref": "state.schema.json"}, "authorizationGrantIds": {"type": "array", "items": {"type": "string"}}}}}
  }
}
